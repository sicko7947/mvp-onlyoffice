# Pinned versions for the OnlyOffice v9 bundle.
# Bump intentionally — keep DOCUMENTSERVER_VERSION and X2T_WASM_TAG on the same minor.

# OnlyOffice DocumentServer (source of web-apps, sdkjs, fonts).
DOCUMENTSERVER_IMAGE=onlyoffice/documentserver
DOCUMENTSERVER_VERSION=9.3.1

# cryptpad/onlyoffice-x2t-wasm release tag (prebuilt WASM converter).
X2T_WASM_REPO=cryptpad/onlyoffice-x2t-wasm
X2T_WASM_TAG=v9.3.0+0

# Target directory inside the Next.js public/ tree.
TARGET_VERSION_DIR=9
